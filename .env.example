# Environment variables for NLP Learning Workflow
# Copy this file to .env and fill in your values

# Required: Anthropic API key. Every generation stage runs on Claude.
ANTHROPIC_API_KEY=

# Optional: OpenAI API key. Only used for OpenAI embeddings
# (EMBEDDING_PROVIDER=openai); generation does not use it.
OPENAI_API_KEY=

# Database Configuration (Supabase)
SUPABASE_URL=
SUPABASE_KEY=

# Vector Store Configuration (Qdrant)
# For local development: http://localhost:6333
# For cloud: https://xxxx.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Leave empty for local, add key for cloud

# Optional: Alternative LLM Providers
DEEPSEEK_API_KEY=  # Podcast Ground Pack extraction (calls 1-4); Claude Haiku 5.5
                   # answers when DeepSeek fails. Compose requires this key.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: Search API Keys
SEMANTIC_SCHOLAR_API_KEY=  # Optional, works without but has lower rate limits
OPENALEX_EMAIL=  # Polite request for OpenAlex API

# Application Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
PAPERS_PER_DAY=2  # Default number of papers to process

# Which model runs each generation stage. The defaults live in
# nlp_pillars/llm_routes.py; set one of these to move a stage.
# LLM_SUMMARIZE_MODEL=claude-haiku-5-5
# LLM_SYNTHESIZE_MODEL=claude-haiku-5-5   # the lesson; claude-sonnet-5-5 is better
# LLM_QUIZ_MODEL=claude-haiku-5-5
# LLM_DISCOVER_MODEL=claude-haiku-5-5
# LLM_CONCEPTS_MODEL=claude-haiku-5-5
# LLM_PODCAST_EXTRACTION_MODEL=deepseek-flash
# LLM_PODCAST_SYNTHESIS_MODEL=claude-sonnet-5
# LLM_FACTCHECK_EXTRACT_MODEL=claude-haiku-5-5
# LLM_FACTCHECK_SCREEN_MODEL=claude-haiku-5-5
# LLM_FACTCHECK_REJUDGE_MODEL=claude-sonnet-5-5
# LLM_PLAYGROUND_MODEL=claude-sonnet-5          # Paper Playground explain pass
# LLM_PLAYGROUND_ALIGN_MODEL=claude-haiku-5-5   # Listen page code follow-along

# Paper Playground (docs/PLAYGROUND.md). Compose sets PLAYGROUND_DATA_DIR to the
# playground_data volume; a host run defaults to /app/playground-data.
# PLAYGROUND_DATA_DIR=/app/playground-data
# PLAYGROUND_DATA_MAX_BYTES=1000000000         # datasets per playground (1 GB)
# PLAYGROUND_NOTEBOOK_MAX_BYTES=25000000       # largest .ipynb accepted (25 MB)
# PODCAST_EXTRACTION_PROVIDER=anthropic   # put Claude in front of DeepSeek

# Scheduling (for automated runs)
SCHEDULE_ENABLED=false
SCHEDULE_TIME=08:00  # 24-hour format
SCHEDULE_TIMEZONE=UTC

# Feature Flags
# Fact-check each saved podcast script. On when unset. A failed check does
# not change the script. Backfill of the 7 existing scripts is about $0.6–1.3:
# python -m nlp_pillars.cli factcheck backfill
# FACTCHECK_AUTO_DISPATCH=true
ENABLE_QUIZ_GENERATION=true
ENABLE_PODCAST_SCRIPTS=false
ENABLE_SPACED_REPETITION=true
ENABLE_CACHE=true

# Paths (optional, defaults will be used if not set)
PDF_CACHE_DIR=./data/pdfs
LOG_DIR=./logs
EXPORT_DIR=./exports

# Obsidian vault. Off unless true. The scheduler then refreshes the vault
# after the daily run. On the host, VAULT_DIR is the folder Obsidian opens
# (default ~/NLP-Vault). Compose sets VAULT_DIR=/vault inside the container
# and bind-mounts VAULT_HOST_DIR (default $HOME/NLP-Vault) there.
VAULT_EXPORT_ENABLED=false
# VAULT_DIR=~/NLP-Vault
# VAULT_HOST_DIR=

# Remote access (docs/remote-access.md). Needed only for requests that arrive
# through the Cloudflare Tunnel; the desktop at http://localhost:8000 needs
# neither. With these unset, every remote request is refused.
# Zero Trust > Settings > Custom Pages shows the team domain; the application
# AUD tag is on the Access application's Overview tab.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional extra check on the token's email claim (comma-separated).
# CF_ACCESS_ALLOWED_EMAILS=

# Most the app may record spending in one day (USD) across paper processing,
# podcast scripts and fact-checks. Costly actions are refused once it is
# reached; 0 refuses them all. The day rolls over at midnight in
# SPEND_CAP_TIMEZONE (an IANA name, default UTC).
DAILY_SPEND_CAP_USD=2
# SPEND_CAP_TIMEZONE=UTC
